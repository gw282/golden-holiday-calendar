{
  "name": "full-stack",
  "version": "0.18.0",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "package": "next build && node scripts/package.mjs",
    "dev:lan": "next dev -H 0.0.0.0",
    "desktop:build": "npm run package && node scripts/desktop-package.mjs && electron-builder --win nsis",
    "tauri:dev": "tauri dev",
    "tauri:prepare": "npm run package && node scripts/tauri-package.mjs",
    "tauri:build": "npm run tauri:prepare && tauri build"
  },
  "build": {
    "appId": "com.goldenholidaycalendar.desktop",
    "productName": "Golden Holiday Calendar",
    "directories": {
      "output": "release-desktop"
    },
    "files": ["electron/**/*", "package.json", "!node_modules/@anthropic-ai/**"],
    "extraResources": [{ "from": "desktop-dist", "to": "app", "filter": ["**/*"] }],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "@libsql/client": "^0.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
