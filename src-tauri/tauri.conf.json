{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MG 매니지",
  "version": "0.27.0",
  "identifier": "com.mgmanage.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare && npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "개인 제작 (비공식 도구)",
    "shortDescription": "연차 하루로 연휴를 만드는 캘린더",
    "longDescription": "달력에서 날짜를 고르면 그 날이 낀 연휴 조합을 보여줍니다. 연차·특별휴가 잔고, 반복 일정, 윈도우 알림을 지원합니다.",
    "resources": {
      "runtime/app": "app",
      "runtime/node.exe": "node.exe"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["Korean", "English"]
      }
    }
  }
}
