# 구글 캘린더 연동 (없으면 그 기능만 꺼진 채로 앱은 정상 동작한다)
#
# 만드는 곳: 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보
#   1) Google Calendar API 사용 설정
#   2) OAuth 동의 화면 > 외부 > 테스트 사용자에 본인 지메일 추가
#   3) 사용자 인증 정보 만들기 > OAuth 클라이언트 ID > 웹 애플리케이션
#      승인된 리디렉션 URI 에 아래 주소를 **글자 하나까지 똑같이** 등록
#         http://localhost:3000/api/google/callback
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채우고 개발 서버를 다시 띄운다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 포트를 바꿔 쓰는 경우에만. 콘솔에 등록한 주소와 반드시 같아야 한다
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 비밀번호 한 겹 (호스팅할 때는 반드시 넣는다)
#
# 이 앱에는 로그인이 없다. 인터넷에 올리면 주소를 아는 누구나 일정을 고칠 수 있고
# 챗봇 요금도 서버를 띄운 계정에 붙는다. 값을 넣으면 브라우저 기본 암호 창이 뜬다
# (아이디 칸은 아무거나 — 비밀번호만 본다). 비워 두면 문이 없는 것과 같다.
# 로컬 개발에서는 비워 두는 것을 권한다.
APP_PASSWORD=

# 챗봇 끄기 — 배포본에서는 켠다 (1이면 꺼진다)
#
# 챗봇은 Claude Code를 자식 프로세스로 띄운다. 실행 파일이 215MB이고 RAM을 요구하며
# ANTHROPIC_API_KEY를 서버에 둬야 해서 요금이 그 계정에 붙는다. Fly 이미지는 기본으로
# 바이너리를 담지 않으므로(Dockerfile의 WITH_CHAT) 그 배포본에서는 이 값이 1이어야 한다.
# 로컬에서는 비워 둔다.
# CHAT_DISABLED=1

# Turso (클라우드 DB) — 없으면 로컬 파일 data/app.db를 쓴다
#
# 이 둘이 있으면 libSQL 클라이언트가 원격에 붙고, 없으면 file:./data/app.db로 붙는다.
# 같은 코드가 양쪽을 다 본다 — 주소만 다르다.
#   turso db create golden-holiday-calendar
#   turso db show --url golden-holiday-calendar
#   turso db tokens create golden-holiday-calendar
# TURSO_DATABASE_URL=libsql://...turso.io
# TURSO_AUTH_TOKEN=
