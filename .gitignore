# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 안내용 견본이라 공유해도 된다
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite
/data

# 지우기로 한 파일들 — 삭제 권한이 없어 확장자만 바꿔 두었다.
# gitignore에 넣어야 Tailwind가 훑지 않는다 (안 그러면 없앤 컴포넌트의 클래스가 되살아난다).
*.removed

# Stitch 스크래치 (디자인 시안 내려받기)
.stitch-out/

# 개인 설정 (훅 경로가 이 PC 기준이라 공유하지 않는다)
.claude/settings.local.json

# 배포용 꾸러미 (npm run package)
dist/
src-tauri/target/
src-tauri/runtime/
src-tauri/gen/schemas/
golden-holiday-calendar-internal-windows.zip

# Stitch 시안 작업용 임시 도구 (앱과 무관)
.stitch.mjs
.stitch.sh
.prompt.txt
